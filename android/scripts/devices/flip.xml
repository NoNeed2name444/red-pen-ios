<?xml version="1.0" encoding="UTF-8"?>
<!--
  A flip-style foldable for the window matrix (T0139). cmdline-tools' avdmanager lists book
  folds (pixel_fold, pixel_9_pro_fold, pixel_10_pro_fold) but no flip, so this profile is
  installed into ~/.android/devices.xml by .github/workflows/android.yml when the runner's
  list has none. A tall 1080 x 2640 inner screen at 420 dpi (411 x 1006 dp) folding across its
  middle, and a small cover: the top 1080 x 1056 px (411 x 402 dp) of the panel, the emulator's
  way of modelling a folded display. Copied from the stock pixel_9_pro_fold entry's shape.
-->
<d:devices xmlns:d="http://schemas.android.com/sdk/devices/9">
    <d:device>
        <d:name>Stethoscore flip</d:name>
        <d:id>stethoscore_flip</d:id>
        <d:manufacturer>User</d:manufacturer>
        <d:hardware>
            <d:screen>
                <d:screen-size>normal</d:screen-size>
                <d:diagonal-length>6.9</d:diagonal-length>
                <d:pixel-density>420dpi</d:pixel-density>
                <d:screen-ratio>long</d:screen-ratio>
                <d:dimensions>
                    <d:x-dimension>1080</d:x-dimension>
                    <d:y-dimension>2640</d:y-dimension>
                </d:dimensions>
                <d:xdpi>413.0</d:xdpi>
                <d:ydpi>413.0</d:ydpi>
                <d:touch>
                    <d:multitouch>jazz-hands</d:multitouch>
                    <d:mechanism>finger</d:mechanism>
                    <d:screen-type>capacitive</d:screen-type>
                </d:touch>
                <d:foldable-region>
                    <d:x-folded-offset>0</d:x-folded-offset>
                    <d:y-folded-offset>0</d:y-folded-offset>
                    <d:x-folded-dimension>1080</d:x-folded-dimension>
                    <d:y-folded-dimension>1056</d:y-folded-dimension>
                </d:foldable-region>
            </d:screen>
            <d:hinge>
                <d:count>1</d:count>
                <d:type>1</d:type>
                <d:sub-type>1</d:sub-type>
                <d:ranges>0-180</d:ranges>
                <d:defaults>180</d:defaults>
                <d:areas>0-1320-1080-0</d:areas>
                <d:change-orientation-on-fold>0</d:change-orientation-on-fold>
                <d:posture-list>1, 2, 3</d:posture-list>
                <d:hinge-angles-posture-definitions>0-30, 30-150, 150-180</d:hinge-angles-posture-definitions>
            </d:hinge>
            <d:networking>Wifi</d:networking>
            <d:sensors>Accelerometer Gyroscope</d:sensors>
            <d:mic>true</d:mic>
            <d:keyboard>nokeys</d:keyboard>
            <d:nav>nonav</d:nav>
            <d:ram unit="MiB">4096</d:ram>
            <d:buttons>soft</d:buttons>
            <d:internal-storage unit="MiB">8192</d:internal-storage>
            <d:removable-storage unit="MiB"></d:removable-storage>
            <d:cpu>Generic CPU</d:cpu>
            <d:gpu>Generic GPU</d:gpu>
            <d:abis>
                x86_64
            </d:abis>
            <d:dock> </d:dock>
            <d:power-type>battery</d:power-type>
        </d:hardware>
        <d:software>
            <d:api-level>35-</d:api-level>
            <d:live-wallpaper-support>true</d:live-wallpaper-support>
            <d:bluetooth-profiles> </d:bluetooth-profiles>
            <d:gl-version>3.0</d:gl-version>
            <d:gl-extensions> </d:gl-extensions>
            <d:status-bar>true</d:status-bar>
        </d:software>
        <d:state name="Portrait" default="true">
            <d:description>The device in portrait view</d:description>
            <d:screen-orientation>port</d:screen-orientation>
            <d:keyboard-state>keyssoft</d:keyboard-state>
            <d:nav-state>nonav</d:nav-state>
        </d:state>
        <d:state name="Landscape">
            <d:description>The device in landscape view</d:description>
            <d:screen-orientation>land</d:screen-orientation>
            <d:keyboard-state>keyssoft</d:keyboard-state>
            <d:nav-state>nonav</d:nav-state>
        </d:state>
    </d:device>
</d:devices>
