{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ is a study aid for students. It is NOT a medical tool." : {
      "comment" : "Recording terms screen (RecordingTermsView), shown once before first use. Red warning box, first line. %@ is the app's name (Latin script).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ أداة مساعِدة على الدراسة للطلاب، و**ليس** أداةً طبية."
          }
        }
      }
    },
    "%@ is provided as is, with no promise that anything in it is accurate or complete. To the extent the law allows, %@ and its makers accept no liability for any decision, harm or loss that comes from relying on it." : {
      "comment" : "Recording terms screen (RecordingTermsView), shown once before first use. Both %@ are the app's name.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُقدَّم %1$@ «كما هو»، دون أي تعهّد بدقة ما فيه أو اكتماله. وفي الحدود التي يسمح بها القانون، لا يتحمّل %2$@ ولا صانعوه أي مسؤولية عن أي قرار أو ضرر أو خسارة تنتج عن الاعتماد عليه."
          }
        }
      }
    },
