      }
    },
    "Record people only with their consent" : {
      "comment" : "Recording terms screen (RecordingTermsView), shown once before first use. Heading of a point.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تسجّل أحدًا إلا بموافقته"
          }
        }
      }
    },
    "Recording someone without their permission can be illegal. Only record, upload or transcribe a lecture, talk or conversation when the lecturer and everyone who can be heard have agreed, and your university's rules and the law allow it. You alone are responsible for your recordings and their transcripts." : {
      "comment" : "Recording terms screen (RecordingTermsView), shown once before first use. ",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يكون تسجيل أي شخص دون إذنه مخالفًا للقانون. لا تسجّل محاضرةً أو حديثًا أو محادثةً، ولا ترفعها ولا تفرّغها نصيًا، إلا بعد موافقة المحاضر وكل من يُسمَع صوته، وبما تسمح به أنظمة جامعتك والقانون. أنت وحدك المسؤول عن تسجيلاتك ونصوصها."
          }
        }
      }
    },
    "Review" : {
