    "Read this before you start" : {
      "comment" : "Recording terms screen (RecordingTermsView), shown once before first use. Title.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ هذا قبل أن تبدأ"
