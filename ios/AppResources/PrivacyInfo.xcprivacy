<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Stethoscore's privacy manifest (docs/launch/implementation-plan.md P3.1 and
  the App Privacy table in section 6). No tracking and no tracking domains.
  Required-reason APIs, as used in ios/RedPen:
    UserDefaults   CA92.1  settings and small state, read by this app only
    File timestamp C617.1  modification dates of files in the app's own
                           container (SourceFiles, NarrateVoice, SyncEngine,
                           CloudTranscriber)
    Boot time      35F9.1  CACurrentMediaTime for intervals within the app
                           (PopOutMotion, Graph3DView)
    Disk space     7D9E.1  free space in a crash or failure report the student
                           agreed to send (DiagnosticsPlatform)
  Re-check when a new API from Apple's list is used anywhere in the app.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
